{
  "manifest_version": 3,
  "name": "Smart Web Assistant",
  "version": "1.0.3",
  "description": "AI-powered browser assistant for summarizing and asking questions about web pages.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://*.run.app/*",
    "http://localhost:3000/*"
  ],

  "externally_connectable": {
    "matches": [
      "https://*.run.app/*"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Web Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
